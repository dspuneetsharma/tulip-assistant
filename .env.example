# Only needed for the terminal client and scripts that call Workers AI over REST (npm run chat, check, probe, eval).
# The deployed website does NOT use these: it uses a Workers AI binding and needs no token.
# Do NOT put real values in this file or commit a real .env. Set them as environment variables in your terminal instead.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-token
